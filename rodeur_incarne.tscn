radius = 0.25
height = 1.7

[node name="Rodeur" type="CharacterBody3D"]
script = ExtResource("1_rodeur")

; Réduit à 0,9 (1,53 m au lieu de 1,70) : un pantin un peu plus petit qu'un
; homme, ce qui est plus juste pour une poupée — et 10 % de moins à faire
; passer dans les embrasures. La capsule et la torche ne bougent pas : elles
; portent le comportement, et on ne veut rien changer d'autre.
