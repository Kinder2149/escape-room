[gd_scene load_steps=4 format=3]

; Le rôdeur incarné (jet 11) : même script, même capsule, même torche que le
; rôdeur d'origine — seul le modèle change. Un pantin de 1,70 m avec un vrai
; squelette et trois démarches.
; Il reste une OMBRE, mais plus un aplat noir : trois teintes sombres portées
; par le modèle lui-même — corps presque noir, toile de sac sur la tête et les
; avant-bras, mains et orteils un peu plus clairs. De loin c'est une
; silhouette ; sous la torche, on lit sa démarche.
; Il regarde vers +Z d'origine ; le manoir attend des personnages tournés
; vers -Z, d'où le demi-tour du modèle.

[ext_resource type="Script" path="res://rodeur.gd" id="1_rodeur"]
[ext_resource type="PackedScene" path="res://rodeur_perso.glb" id="2_modele"]

