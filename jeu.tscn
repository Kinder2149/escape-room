; LE PANNEAU D'ACCUEIL (jet 12). Il énonce le but, la chaîne, les gestes,
; le losange des abris et les rôdeurs. Posé en dernier : il se dessine
; par-dessus tout le reste. Le bandeau d'audit ne s'affiche qu'après sa
; fermeture, sinon il naîtrait caché derrière.
; Ce qu'il NE DIT PAS, délibérément : que les rôdeurs sont plus lents que le
; joueur. C'est la stratégie qui viderait les neuf cachettes de leur utilité.
; « mouse_filter = 2 » : sans lui, le panneau avalerait les clics avant que le
; jeu les voie, et seul le clavier ferait entrer — alors qu'on promet « une
; touche ».
[node name="Panneau" type="ColorRect" parent="Interface"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.03, 0.04, 0.985)
mouse_filter = 2

[node name="Marges" type="MarginContainer" parent="Interface/Panneau"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 24

