[gd_scene load_steps=19 format=3]

; Scène principale : assemble le décor, le joueur, le rôdeur, la sortie,
; les coffres et les cachettes. À chaque lancement, jeu.gd tire la
; distribution au sort sur les repères des pièces de la maison (voir jeu.gd).

[ext_resource type="Script" path="res://jeu.gd" id="1_jeu"]
[ext_resource type="PackedScene" path="res://maison.tscn" id="2_maison"]
[ext_resource type="PackedScene" path="res://joueur.tscn" id="3_joueur"]
[ext_resource type="PackedScene" path="res://sortie.tscn" id="4_sortie"]
[ext_resource type="PackedScene" path="res://coffre.tscn" id="5_coffre"]
[ext_resource type="PackedScene" path="res://rodeur.tscn" id="6_rodeur"]
[ext_resource type="PackedScene" path="res://cachette.tscn" id="7_cachette"]
[ext_resource type="PackedScene" path="res://coffre_fort.tscn" id="8_coffre_fort"]
[ext_resource type="PackedScene" path="res://rodeur_incarne.tscn" id="9_rodeur_incarne"]

[sub_resource type="LabelSettings" id="LabelSettings_gagne"]
font_size = 96
font_color = Color(1, 1, 1, 1)
outline_size = 12
outline_color = Color(0, 0, 0, 1)

[sub_resource type="LabelSettings" id="LabelSettings_perdu"]
font_size = 96
font_color = Color(0.9, 0.15, 0.15, 1)
outline_size = 12
outline_color = Color(0, 0, 0, 1)

[sub_resource type="LabelSettings" id="LabelSettings_action"]
font_size = 28
font_color = Color(1, 1, 1, 1)
outline_size = 6
outline_color = Color(0, 0, 0, 1)

[sub_resource type="LabelSettings" id="LabelSettings_audit"]
font_size = 26
font_color = Color(1, 0.25, 0.2, 1)
outline_size = 8
outline_color = Color(0, 0, 0, 1)

[node name="Jeu" type="Node3D"]
script = ExtResource("1_jeu")

[node name="Maison" parent="." instance=ExtResource("2_maison")]

[node name="Joueur" parent="." instance=ExtResource("3_joueur")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -7.5, 0.1, -7.5)

[node name="Sortie" parent="." instance=ExtResource("4_sortie")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.8, 0, 8.75)

; Les deux coffres ne sont plus attachés à une pièce : jeu.gd les distribue au
; démarrage. Leur position ici n'est qu'un point de départ, aussitôt écrasé.
[node name="CoffreA" parent="." instance=ExtResource("5_coffre")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 0, -7.5)

[node name="CoffreB" parent="." instance=ExtResource("5_coffre")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -9.8, 0, 4.5)

; Le coffre-fort (jet 9) : sa propre scène, car son modèle 3D diffère —
; plus gros, en métal, le badge dedans. Le reste est identique à un coffre.
[node name="CoffreFort" parent="." instance=ExtResource("8_coffre_fort")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 8, 0, 7.5)

; UN RÔDEUR PAR NIVEAU (jet 8). L'ordre dans le groupe « rodeurs » décide de
; leur étage, du bas vers le haut — voir lance_les_rodeurs dans jeu.gd.
; Rangés dans un couloir et invisibles tant que la maison n'est pas prête :
; jeu.gd les pose ensuite sur un départ sûr de leur niveau (voir place_rodeur).
; Leur position de rangement ne doit coïncider avec AUCUN repère de réveil —
; deux corps au même endroit, et la physique expulse le joueur (défaut du Salon).
; ESSAI (jet 11) : celui du rez-de-chaussée est le pantin animé, celui de
; l'étage garde l'ancienne silhouette. Les deux dans la même partie, pour
; pouvoir comparer sans changer de fichier.
[node name="Rodeur" parent="." groups=["rodeurs"] instance=ExtResource("9_rodeur_incarne")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.1, 0)
visible = false

[node name="RodeurEtage" parent="." groups=["rodeurs"] instance=ExtResource("6_rodeur")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3.3, 0)
visible = false

; L'armoire (chambre) : on s'y tient debout, face tournée vers -X.
[node name="CachetteArmoire" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -4.81, 0, 6)
largeur_face = 1.5
hauteur_face = 1.9
hauteur_vue = 1.5

; La penderie (salon) : on s'y tient debout, comme dans l'armoire.
; Arbitrage de Kinder (jet 7) : les cachettes sont des meubles où l'on ENTRE
; vraiment — plus de « derrière un meuble ». Le canapé reste un simple meuble.
[node name="CachettePenderie" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 3.6, 0, -8.0)
largeur_face = 1.3
hauteur_face = 2.0
hauteur_vue = 1.5

; La baignoire (salle de bain) : couché dedans, les yeux au ras du bord.
; La zone de visée monte bien plus haut que la baignoire : on ne la traverse
; pas, et sans ça il faudrait viser ses pieds pour y entrer.
[node name="CachetteBaignoire" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0, 7.89)
largeur_face = 1.8
hauteur_face = 1.6
hauteur_vue = 0.7
recul_sortie = 0.6

; Le bureau (la pièce de la porte rouge) : à plat dessous. Décalé de la chaise
; et les yeux sous son assise, sinon elle bouche toute la vue. On ressort loin
; devant, sinon on réapparaîtrait dedans.
[node name="CachetteBureau" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 3.8, 0, 3.41)
largeur_face = 1.5
hauteur_face = 1.6
hauteur_vue = 0.35
recul_sortie = 1.2

; La grande table (salle à manger) : à plat dessous, comme sous le bureau.
; On l'aborde par le petit côté est — les chaises occupent les côtés nord
; et sud. On ressort d'un bon pas, sinon on réapparaîtrait sous le plateau.
; La zone de visée monte bien plus haut que le plateau : sans ça, il faudrait
; viser ses pieds pour entrer (leçon du bureau, jet 4).
[node name="CachetteTable" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 15.2, 0, -5.2)
largeur_face = 1.4
hauteur_face = 1.6
hauteur_vue = 0.35
recul_sortie = 0.8

; La malle (bibliothèque) : couché dedans, les yeux au ras du couvercle,
; comme la baignoire. La zone de visée monte plus haut que la malle (leçon
; du bureau, jet 4). Le fauteuil reste un simple meuble.
[node name="CachetteMalle" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12.1, 0, 7.9)
largeur_face = 1.5
hauteur_face = 1.5
hauteur_vue = 0.5
decalage_vue = 0.15
recul_sortie = 0.7

; ---- LES TROIS CACHETTES DE L'ÉTAGE (jet 8) ----

; L'armoire (chambre d'amis) : on s'y tient debout, abordée par le sud.
[node name="CachetteArmoireEtage" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 1.5, 3.2, -8)
largeur_face = 1.4
hauteur_face = 1.9
hauteur_vue = 1.5

; La penderie (dressing) : debout également, abordée par l'est.
[node name="CachettePenderieEtage" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 12.75, 3.2, -5.5)
largeur_face = 1.8
hauteur_face = 2.0
hauteur_vue = 1.5

; Sous le grand lit (chambre de maître) : à plat, on s'y glisse par le sud.
; La zone de visée monte bien plus haut que le lit — sans quoi il faudrait
; viser le sol pour entrer (leçon du bureau, jet 4, et de la table, jet 7).
[node name="CachetteSousLeLit" parent="." groups=["cachettes"] instance=ExtResource("7_cachette")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 5.5, 3.2, -4.95)
largeur_face = 1.5
hauteur_face = 1.6
hauteur_vue = 0.35
recul_sortie = 0.8

