; Le filet de la maison : si un emplacement est cassé (repère dans un mur,
; porte rouge à l'intérieur...), la liste des problèmes s'affiche ici en rouge
; dès le lancement. Invisible quand tout va bien.
[node name="MessageAudit" type="Label" parent="Interface"]
anchors_preset = 10
anchor_right = 1.0
offset_top = 64.0
grow_horizontal = 2
label_settings = SubResource("LabelSettings_audit")
horizontal_alignment = 1

