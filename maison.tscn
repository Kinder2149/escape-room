[gd_scene load_steps=31 format=3]

; Le manoir est sculpté dans un bloc plein (CSG) : on creuse les pièces,
; les couloirs, puis les ouvertures. Ce qui reste plein fait les murs.
; Emprise : x de -11 à 23.6, z de -9 à 9. Hauteur sous plafond : 3.
; L'aile Est (jet 7) : salle à manger et buanderie au nord, bibliothèque au
; sud, desservies par le couloir prolongé et la GALERIE (le couloir du pignon
; Est) — buanderie et bibliothèque ont deux portes : ce sont elles qui
; referment les boucles permettant de semer le rôdeur en tournant.
; La maison est CLOSE : aucune ouverture vers l'extérieur. La seule issue est la
; porte rouge, que jeu.gd plaque contre un mur, à un endroit tiré au sort.
; Les six pièces (scène Pièce, groupe « pieces ») portent les emplacements :
; coffre, porte rouge, réveil. C'est la seule source de ces coordonnées —
; le Jeu et le Rôdeur les interrogent ici.
; Le mobilier vient de Blender (mobilier.glb) ; il est déjà positionné à l'export.
; La carte de navigation (où le rôdeur peut marcher) est calculée au démarrage
; par maison.gd : la géométrie CSG n'existe qu'une fois la scène chargée.
; Les pièces restent HORS du nœud Navigation : leurs repères ne doivent pas
; entrer dans le calcul de la carte.

[ext_resource type="Script" path="res://maison.gd" id="1_maison"]
[ext_resource type="PackedScene" path="res://mobilier.glb" id="2_mobilier"]
[ext_resource type="PackedScene" path="res://piece.tscn" id="3_piece"]

; agent_radius = 0,40 — et c'est un PLAFOND, pas un réglage libre (jet 11).
; Le joueur passe partout où il y a 0,80 m (sa capsule fait 0,40 de rayon).
; La navigation, elle, exige le double de cette marge. Au-delà de 0,40, tout
; passage entre 0,80 m et deux fois la marge devient un endroit où le joueur
; tient debout mais où le rôdeur n'a plus de sol : se plaquer là rendait
; invincible. Essayé à 0,55, défaut constaté en jeu, ramené à 0,40.
[sub_resource type="NavigationMesh" id="NavigationMesh_maison"]
geometry_parsed_geometry_type = 1
agent_radius = 0.4
agent_height = 1.8
agent_max_climb = 0.2
cell_size = 0.15
cell_height = 0.1

[sub_resource type="Environment" id="Environment_maison"]
background_mode = 1
ambient_light_source = 2
ambient_light_color = Color(0.7, 0.75, 0.9, 1)
ambient_light_energy = 0.02

; La masse du manoir — murs et plafonds. Une pierre sombre et légèrement
; chaude plutôt que le gris de chantier d'origine : le décor doit reculer
; pour laisser les sols de pièce et les objets manipulables trancher.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gris"]
albedo_color = Color(0.4, 0.38, 0.36, 1)
roughness = 0.95

; Les sols de circulation : une pierre neutre, ni colorée comme une pièce, ni
; sombre comme un mur. C'est ce qui fait qu'un couloir se lit comme un couloir.
[sub_resource type="StandardMaterial3D" id="Sol_Circulation"]
albedo_color = Color(0.32, 0.31, 0.3, 1)
roughness = 0.9

[sub_resource type="PlaneMesh" id="Plan_CouloirRdc"]
size = Vector2(31, 2.8)

